#!/bin/bash
set -euo pipefail

main() {
    local cmd="${1:-}"
    case "${cmd}" in
        heal)        do_heal ;;
        up)          do_up ;;
        down)        do_down ;;
        start)       do_up ;;
        stop)        do_down ;;
        status)      do_status ;;
        tail-head)   do_tail_head ;;
        tail-worker) do_tail_worker ;;
        log)         do_tail_perf ;;
        build-image) do_build_image ;;
        *)           echo "usage: $0 {heal|up|down|status|log|tail-head|tail-worker|build-image}" >&2; exit 1 ;;
    esac
}


HF_CACHE_DIR=$HOME/.cache/huggingface
MODEL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
MODEL_REVISION=main

USE_LOCAL_IMAGE=0
LOCAL_IMAGE=vllm-for-deepseek-v4-vision-exp-ollie-stack:latest
DOCKER_HUB_IMAGE=0rand/vllm_spark_dsv4-0.29-b12x:latest

CONTAINER_NAME=vision_exp

SERVED_MODEL_NAME=default
PORT=8000

CLUSTER_NODES=192.168.100.10,192.168.100.11

FIX_BROKEN_VISION=1
FIX_DSPARK_K_5=1
FIX_PREFIX_CACHE_DEDUPE=1
FIX_PREFIX_REPLAY_TAIL=1
FIX_LINEAR_MARLIN_O_PROJ=1
FIX_LINEAR_TRITON_E8M0=0
FIX_LINEAR_CUTLASS_E8M0=0

FIX_TOOLCALL_ORPHAN_INVOKE=0      # PR #55954 / d98c8c0: parse invoke without <tool_calls> wrapper
FIX_TOOLCALL_MISSPELLED_WRAPPER=0 # PR #56141 / 9e25706: tolerate <toolcalls>/<tool> misspellings


serve_script() {
    cat <<EOF
#!/bin/bash
set -euo pipefail

# DEBUG: disabled for now, to be tested
#export VLLM_MARLIN_USE_ATOMIC_ADD=1

vllm serve ${MODEL} \
--host 0.0.0.0 \
--port ${PORT} \
--served-model-name ${SERVED_MODEL_NAME} \
--default-chat-template-kwargs.temperature=1.0 \
--default-chat-template-kwargs.top_p=0.95 \
--default-chat-template-kwargs.thinking=true \
--default-chat-template-kwargs.reasoning_effort=high \
--default-chat-template-kwargs.drop_thinking=false \
--trust-remote-code \
--tensor-parallel-size 2 \
--kv-cache-dtype fp8 \
--block-size 256 \
--max-model-len 1048576 \
--max-num-seqs 12 \
--max-num-batched-tokens 2048 \
--gpu-memory-utilization 0.87 \
--enable-prefix-caching \
--async-scheduling \
--enable-chunked-prefill \
--long-prefill-token-threshold 1024 \
--skip-mm-profiling \
--limit-mm-per-prompt '{"image": 200}' \
--tokenizer-mode deepseek_v4 \
--tool-call-parser deepseek_v4 \
--enable-auto-tool-choice \
--reasoning-parser deepseek_v4 \
--reasoning-config '{"reasoning_parser":"deepseek_v4","reasoning_start_str":"","reasoning_end_str":""}' \
--moe-backend marlin \
--linear-backend marlin \
--disable-custom-all-reduce \
--compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}' \
--max-cudagraph-capture-size 88 \
--attention-backend FLASHINFER_MLA_SPARSE_DSV4 \
--speculative-config '{"method":"dspark","model":"deepseek-ai/DeepSeek-V4-Flash-Vision-Exp","num_speculative_tokens":5,"draft_sample_method":"probabilistic","attention_backend":"FLASHINFER_MLA_SPARSE_DSV4","enable_adaptive_verification":false}'
EOF

}


SELF="$(basename "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/lib.sh"

do_up() {
    do_down

    ensure_launcher
    ensure_model
    ensure_image

    local -a mod_args
    mapfile -t mod_args < <(build_apply_mod_args)

    launch_cluster "$(serve_script)" "${mod_args[@]}"

    do_tail_head_till "Application startup complete."

    continue_perf_tail
}

build_apply_mod_args() {
    local -a mod_args=()
    add_mod_arg_if_1 "$FIX_BROKEN_VISION"        fix-dsv4-mm-prefix-span
    add_mod_arg_if_1 "$FIX_DSPARK_K_5"           fix-dspark-mtp-divisibility
    add_mod_arg_if_1 "$FIX_PREFIX_REPLAY_TAIL"   fix-dsv4-prefix-replay-tail
    add_mod_arg_if_1 "$FIX_PREFIX_CACHE_DEDUPE"  fix-vllm-prefix-cache-dedupe
    add_mod_arg_if_1 "$FIX_LINEAR_MARLIN_O_PROJ" fix-vllm-linear-marlin-o-proj
    add_mod_arg_if_1 "$FIX_LINEAR_TRITON_E8M0"   fix-vllm-linear-triton-e8m0
    add_mod_arg_if_1 "$FIX_LINEAR_CUTLASS_E8M0"  fix-vllm-linear-cutlass-e8m0
    add_mod_arg_if_1 "$FIX_TOOLCALL_ORPHAN_INVOKE"        fix-dsv4-toolcall-orphan-invoke
    add_mod_arg_if_1 "$FIX_TOOLCALL_MISSPELLED_WRAPPER"   fix-dsv4-toolcall-misspelled-wrapper

    printf '%s\n' "${mod_args[@]}"
}

main "$@"
